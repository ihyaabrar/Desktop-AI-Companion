# Copy to .env and fill in only the providers you want to use.
# By default the app routes to a local Ollama model and needs no keys.

# --- Local default (no keys needed) ---
LLM_PROVIDER=ollama
LLM_MODEL=ollama/qwen2.5:7b
OLLAMA_API_BASE=http://127.0.0.1:11434

# --- Optional cloud providers (BYO key) ---
# Set LLM_MODEL to the provider's model name to switch.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# --- Server ---
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8765
