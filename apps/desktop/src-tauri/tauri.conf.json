{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop AI Companion",
  "version": "0.0.1",
  "identifier": "com.ihyaabrar.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desktop AI Companion",
        "width": 420,
        "height": 640,
        "resizable": true
      },
      {
        "label": "presence",
        "title": "Companion presence",
        "url": "presence.html",
        "width": 200,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "x": 1500,
        "y": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
